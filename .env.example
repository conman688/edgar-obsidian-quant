# SEC requires a User-Agent naming you and a contact email. Copy to .env and edit.
SEC_USER_AGENT="Your Name you@example.com"
# Optional: where the DuckDB file and raw downloads live (default: ./data)
# EOQ_DATA_DIR=data
# Obsidian vault the notes are written to (M6). Keep it outside this repo.
# EOQ_VAULT_DIR=/path/to/your/vault
# Weekly DuckDB backups (M9): a folder on another disk; the last 4 are kept.
# EOQ_BACKUP_DIR=/Volumes/YourDrive/edgar-obsidian-quant-backups
